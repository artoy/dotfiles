# Ghostty configuration.

# JetBrains Mono for the alphabet, 游ゴシック体 for Japanese.
# Glyphs missing from JetBrains Mono come from the built-in Symbols Nerd Font.
font-family = JetBrains Mono
font-codepoint-map = U+3000-U+30FF,U+31F0-U+31FF,U+3200-U+32FF,U+3400-U+4DBF,U+4E00-U+9FFF,U+F900-U+FAFF,U+FE30-U+FE4F,U+FF00-U+FFEF=YuGothic
font-size = 14
mouse-hide-while-typing = true

# Window
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-save-state = always
quit-after-last-window-closed = true
confirm-close-surface = false

macos-option-as-alt = true

# Moving between tabs
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9
